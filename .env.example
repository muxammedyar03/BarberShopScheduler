# Next.js — API port must match docker-compose (api maps 10120:8080)
# Note: host port 8080 may be used by other containers on your machine
NEXT_PUBLIC_API_URL=http://localhost:10120
API_URL=http://localhost:10120

# JWT — must match Go API (api + web in docker-compose)
JWT_SECRET=dev-only-change-me-use-32-char-minimum-secret!!

# Local Postgres (docker-compose postgres maps 10110:5432) — DBeaver: see docs/DATABASE.md
DB_USER=barber
DB_PASSWORD=barber
DB_HOST=localhost
DB_PORT=10110
DB_NAME=barber_queue
DB_SSLMODE=disable

# DATABASE_URL=postgres://barber:barber@localhost:10110/barber_queue?sslmode=disable
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE}
REDIS_URL=redis://localhost:6379/0

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData().role == 'admin';
    }
    
    function isBarber() {
      return hasRole('barber');
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- COLLECTION RULES ---

    // 1. Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn() && isOwner(userId); 
      allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])) || isAdmin();
    }

    // 2. Barbers
    match /barbers/{barberId} {
      allow read: if true; // Public for clients to see
      allow create, update: if isAdmin() || (isBarber() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 3. Appointments
    match /appointments/{appointmentId} {
      allow read: if true; // Allowed for guests to see schedule
      allow create: if true; // Allowed for guests to book (per current app logic)
      allow update: if (isSignedIn() && (isAdmin() || (isBarber() && resource.data.barberId != null) || isOwner(resource.data.clientId)));
      allow delete: if isAdmin();
    }

    // 4. Invoices
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isBarber() && resource.data.barberId != null); // Barber needs their ID to see their invoice
      allow write: if isAdmin();
    }

    // 5. CashLogs (PRIVATE - Admin restricted per user request)
    match /cashLogs/{logId} {
      allow read, write: if isBarber() && resource.data.barberId != null; // Barber only
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

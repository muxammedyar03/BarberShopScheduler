{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account information and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "barber", "client"] },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Barber": {
      "title": "Barber",
      "description": "Barber profile and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "avatar": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isBlocked": { "type": "boolean" },
        "workingHours": {
          "type": "object",
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        },
        "workingDays": { "type": "array" },
        "status": { "type": "string" },
        "monthlyFee": { "type": "number" },
        "billingDay": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["id", "name", "isActive"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Client booking details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "barberId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "price": { "type": "number" },
        "clientId": { "type": "string" }
      },
      "required": ["id", "barberId", "clientName", "startTime", "date", "status"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Monthly fee invoices for barbers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "barberId": { "type": "string" },
        "barberName": { "type": "string" },
        "amount": { "type": "number" },
        "issueDate": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "barberId", "amount", "status"]
    },
    "CashLog": {
      "title": "Cash Log",
      "description": "Financial transaction logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "barberId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "barberId", "type", "amount", "date"]
    }
  },
  "firestore": {
    "users/{userId}": { "schema": "User", "description": "Registered users" },
    "barbers/{barberId}": { "schema": "Barber", "description": "Barber master profiles" },
    "appointments/{appointmentId}": { "schema": "Appointment", "description": "Client appointments" },
    "invoices/{invoiceId}": { "schema": "Invoice", "description": "System usage invoices" },
    "cashLogs/{logId}": { "schema": "CashLog", "description": "Income/Expense logs" }
  }
}
